{
  "name": "@fea-docs/obsidian",
  "version": "1.0.0",
  "description": "Obsidian syntax handlers for fea-docs normalization",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fea-docs/schema": "workspace:*",
    "@fea-docs/syntax-engine": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.5.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT"
}
