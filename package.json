{
  "name": "fea-docs-monorepo",
  "version": "2.1.0",
  "private": true,
  "description": "fea-docs package workspace",
  "scripts": {
    "build": "pnpm --filter './packages/**' -r --sort run build",
    "dev": "pnpm --filter @fea-docs/cli run dev",
    "test": "pnpm --filter @fea-docs/cli run test",
    "test:watch": "pnpm --filter @fea-docs/cli run test:watch",
    "typecheck": "pnpm --filter './packages/**' -r --sort run build && pnpm --filter './packages/**' -r --sort run typecheck",
    "lint": "pnpm --filter @fea-docs/cli run lint"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
