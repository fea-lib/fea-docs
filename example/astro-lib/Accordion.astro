---
interface Props {
  title: string;
}
const { title } = Astro.props;
---

<details class="accordion">
  <summary>{title}</summary>
  <div class="accordion-body">
    <slot />
  </div>
</details>

<style>
  .accordion {
    border: 1px solid #ccc;
    border-radius: 4px;
    margin: 0.5rem 0;
  }
  summary {
    padding: 0.5rem 0.75rem;
    cursor: pointer;
    font-weight: bold;
    user-select: none;
  }
  .accordion-body {
    padding: 0.5rem 0.75rem;
    border-top: 1px solid #ccc;
  }
</style>
